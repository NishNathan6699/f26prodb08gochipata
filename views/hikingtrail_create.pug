extends layout

block content
  h1= title
  form(id='TrailForm', action="/resource/hikingtrails", method="POST")
    div.form-group
      label.trailAttr(for='name') Name
      input#name(type='text', name='name')
    div.form-group
      label.trailAttr(for='location') Location
      input#location(type='text', name='location')
    div.form-group
      label.trailAttr(for='difficulty') Difficulty
      input#difficulty(type='text', name='difficulty')
    div.form-group
      label.trailAttr(for='length') Length
      input#length(type='number', step='any', name='length')
    input(type="submit")
  script.
    document.forms['TrailForm'].addEventListener('submit', (event) => {
      event.preventDefault();
      fetch(event.target.action, {
        method: 'POST',
        body: new URLSearchParams(new FormData(event.target))
      }).then((resp) => {
        return resp.json();
      }).then((body) => {
        alert("Save succeeded");
      }).catch((error) => {
        alert("Save failed " + error);
      });
    });
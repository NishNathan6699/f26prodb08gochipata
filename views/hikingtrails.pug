
extends layout

block content
  h1= title
  p Available Hiking Trails

  a.btn.btn-primary.mb-3(href='/hikingtrails/create') Add Trail

  - let items = results

  div.container-fluid
    div.row
      each item, index in items
        div.col-12.col-md-5.col-xl-3.border.rounded.p-3.m-2
          h5 #{item.name}
          p Location: #{item.location}
          p Distance: #{item.length} miles
          p Difficulty: #{item.difficulty}

          // LAB 13 PART 1: Buttons for each trail
          - let detailLink = '/hikingtrails/' + item._id
          - let updateLink = '/hikingtrails/update?id=' + item._id
          - let deleteLink = '/hikingtrails/' + item._id + '/delete'

          .d-flex.gap-2.flex-wrap
            a.btn.btn-outline-primary(href=detailLink) Inspect
            a.btn.btn-primary(href=updateLink) Update
            a.btn.btn-outline-danger(href=deleteLink) Delete

      else
        p No hiking trails found.

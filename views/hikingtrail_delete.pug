extends layout

block content
  h1= title
  div
    div.row
      div(class='trailAttr mr-3') Trail ID is:
      div #{trail._id}
    div.row
      div(class='trailAttr mr-3') Name is:
      div #{trail.name}
    div.row
      div(class='trailAttr mr-3') Location is:
      div #{trail.location}
    div.row
      div(class='trailAttr mr-3') Difficulty is:
      div #{trail.difficulty}
    div.row
      div(class='trailAttr mr-3') Length is:
      div #{trail.length}
  button(class="btn btn-danger m-2" onclick="deleteOnid()") Delete
  button(class="btn btn-secondary m-2" onclick="cancel()") Cancel
  script.
    const actionid = "/resource/hikingtrails/#{trail._id}";
    function cancel() {
      window.location.href = '/hikingtrails';
    }
    function deleteOnid() {
      fetch(actionid, { method: 'DELETE' })
        .then((resp) => resp.json())
        .then((body) => {
          alert("Delete succeeded");
          window.location.href = '/hikingtrails';
        })
        .catch((error) => alert("Delete failed " + error));
    }